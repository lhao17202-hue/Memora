# Copy this file to .env and change local paths/secrets for your machine.
# The real .env file is intentionally git-ignored.

# Core storage.
MEMORA_ROOT=.memora
MEMORA_BACKEND=sqlite
MEMORA_SQLITE_PATH=.memora/memora.sqlite3

# Retrieval and indexing.
MEMORA_RAG=true
MEMORA_RETRIEVAL_MODE=hybrid
MEMORA_KEYWORD_RECALL=auto
MEMORA_FTS_ENABLED=true
MEMORA_FTS_CANDIDATE_LIMIT=100
MEMORA_VECTOR_CANDIDATE_LIMIT=50
MEMORA_KEYWORD_CANDIDATE_LIMIT=50
MEMORA_RERANKER=deterministic
MEMORA_RERANK_CANDIDATE_LIMIT=100
MEMORA_MAX_RETRIEVED_MEMORIES=8
MEMORA_MAX_MEMORY_PROMPT_TOKENS=2000

# Local BGE-M3 embedding provider.
MEMORA_EMBEDDING_PROVIDER=bge
MEMORA_EMBEDDING_MODEL=bge-m3
MEMORA_EMBEDDING_MODEL_PATH=C:\models\bge-m3
MEMORA_EMBEDDING_DIMENSION=1024
MEMORA_EMBEDDING_BATCH_SIZE=8
MEMORA_EMBEDDING_FP16=true
MEMORA_EMBEDDING_SPARSE=true
HF_OFFLINE=1

# Vector store. Use "sqlite" for local dense-only vectors, or "qdrant" for
# dense/hybrid vector retrieval.
MEMORA_VECTOR_STORE=qdrant
MEMORA_VECTOR_PATH=.memora/vectors.sqlite3

# Qdrant options. These are mapped into MemoryConfig.vector_store_options.
MEMORA_VECTOR_STORE_URL=http://localhost:6333
MEMORA_VECTOR_STORE_COLLECTION=memora_memories
MEMORA_VECTOR_STORE_TIMEOUT=10
MEMORA_VECTOR_STORE_PREFER_GRPC=false
MEMORA_VECTOR_STORE_RECREATE_COLLECTION=false

# Optional semantic relation thresholds used during memory write conflict/merge checks.
MEMORA_SEMANTIC_WRITE_RELATIONS=true
MEMORA_MIN_SEMANTIC_SCORE=0.25
MEMORA_SEMANTIC_RELATION_THRESHOLD=0.78
MEMORA_SEMANTIC_MERGE_THRESHOLD=0.82
MEMORA_SEMANTIC_CONFLICT_THRESHOLD=0.90
